{
  "name": "mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-server": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.3",
    "dotenv": "^16.4.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.47",
    "typescript": "^5.3.3"
  }
}
